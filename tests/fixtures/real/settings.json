{
  "models": {
    "gemini_api": {
      "access": "gemini_api",
      "key_env": "GOOGLE_API_KEY",
      "model": "gemini-3.5-flash-lite",
      "rpm": 15,
      "tpm": 250000,
      "rpd": 500
    },
    "claude_cli": {
      "access": "claude_cli",
      "command": "claude",
      "model": "claude-sonnet-5-5"
    },
    "codex_cli": {
      "access": "codex_cli",
      "command": "codex",
      "model": "gpt-6.1-terra"
    },
    "openrouter_api": {
      "access": "openrouter_api",
      "key_env": "OPENROUTER_API_KEY",
      "model": "anthropic/claude-haiku-5.5",
      "pages_per_request": 8,
      "max_request_bytes": 20971520
    }
  },
  "operations": {
    "ocr": {
      "allowed": [
        "gemini_api",
        "codex_cli",
        "openrouter_api"
      ]
    },
    "inspection": {
      "allowed": [
        "gemini_api",
        "codex_cli",
        "openrouter_api"
      ]
    },
    "post": {
      "allowed": [
        "claude_cli",
        "gemini_api",
        "codex_cli",
        "openrouter_api"
      ]
    }
  },
  "raw2md-engine": {
    "recognition_batch_size": 8
  },
  "log_file": false
}

{
  "models": {
    "gemini_api": {
      "access": "api",
      "key_env": "GOOGLE_API_KEY",
      "model": "gemini-3.5-flash-lite",
      "rpm": 15,
      "tpm": 250000,
      "rpd": 500
    },
    "claude_cli": {
      "access": "cli",
      "command": "claude",
      "model": "claude-sonnet-5"
    }
  },
  "operations": {
    "ocr": {
      "allowed": [
        "gemini_api"
      ]
    },
    "inspection": {
      "allowed": [
        "gemini_api"
      ]
    },
    "post": {
      "allowed": [
        "claude_cli",
        "gemini_api"
      ]
    }
  },
  "marker": {
    "recognition_batch_size": 8
  },
  "log_file": false
}
